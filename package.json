{
  "name": "agent-ready-events-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx server/dev-api.ts",
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'tests/browser/**' --exclude 'tests/experiments/**' --exclude '.worktrees/**'",
    "test:server": "vitest run tests/server",
    "test:browser": "playwright test",
    "test:browser:button-copy": "playwright test --config playwright.button-copy-experiment.config.ts",
    "test:day-27:contract": "vitest run tests/search-events-webmcp-tool.test.ts tests/search-events-tool.test.ts",
    "test:day-27:lifecycle": "vitest run tests/webmcp/current-event-tool-lifecycle.test.ts tests/application/save-event.test.ts",
    "test:day-27:journey": "vitest run tests/integration/day-25-agent-journey.test.ts",
    "test:day-27:boundary": "vitest run tests/server/demo-api.test.ts",
    "test:day-27:browser": "playwright test tests/browser/webmcp-runtime.spec.ts tests/browser/day-24-tool-lifecycle.spec.ts tests/browser/day-25-agent-journey.spec.ts tests/browser/day-26-trusted-boundary.spec.ts",
    "test:day-27": "npm run test:day-27:contract && npm run test:day-27:lifecycle && npm run test:day-27:journey && npm run test:day-27:boundary && npm run test:day-27:browser",
    "test:day-28:tool": "vitest run tests/day-28-search-events-tool.test.ts",
    "test:day-28:browser": "playwright test tests/browser/day-28-button-copy-comparison.spec.ts",
    "test:day-28": "tsx scripts/verify-day-28-comparison.ts",
    "capture:day-28": "tsx scripts/capture-day-28-comparison.ts",
    "capture:articles": "node scripts/capture-article-screenshots.mjs",
    "build": "npm run typecheck && vite build"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "22.20.1",
    "concurrently": "9.2.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
