{
  "name": "agent-ready-events-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'tests/browser/**' --exclude 'tests/experiments/**'",
    "test:browser": "playwright test",
    "test:browser:button-copy": "playwright test --config playwright.button-copy-experiment.config.ts",
    "capture:articles": "node scripts/capture-article-screenshots.mjs",
    "build": "npm run typecheck && vite build"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "22.20.1",
    "typescript": "5.9.3",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
